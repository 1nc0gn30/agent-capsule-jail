#!/usr/bin/env python3
"""Agent Capsule Jail — Live Terminal Status & Telemetry TUI (v2.6.0).
Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform.
Zero external dependencies — queries real loopback daemon (:8105) and bwrap runtime.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
SRC_DIR = ROOT_DIR / "src"
if not SRC_DIR.exists():
    SRC_DIR = Path.home() / "NullAITech" / "agent-capsule-jail" / "src"
if SRC_DIR.exists() and str(SRC_DIR) not in sys.path:
    sys.path.insert(0, str(SRC_DIR))


def fetch_json(url: str, timeout: float = 1.5):
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return json.loads(resp.read().decode("utf-8"))


def collect_snapshot(host: str, port: int) -> dict:
    base = f"http://{host}:{port}"
    snapshot = {
        "tool": "agent-capsule-jail",
        "version": "2.6.0",
        "endpoint": base,
        "online": False,
        "sandbox_mode": "unknown",
        "pids_enforcement": "unknown",
        "health": None,
        "stats": None,
        "recent_capsules": [],
        "error": None,
    }
    try:
        from agent_capsule_jail import __version__
        from agent_capsule_jail.capsule import pids_enforcement, sandbox_mode
        snapshot["version"] = __version__
        snapshot["sandbox_mode"] = sandbox_mode()
        snapshot["pids_enforcement"] = pids_enforcement()
    except Exception:
        pass

    try:
        snapshot["health"] = fetch_json(f"{base}/health")
        snapshot["stats"] = fetch_json(f"{base}/api/stats")
        caps = fetch_json(f"{base}/api/capsules?limit=8")
        snapshot["recent_capsules"] = caps.get("capsules", []) if isinstance(caps, dict) else []
        snapshot["online"] = True
        if isinstance(snapshot["health"], dict):
            snapshot["sandbox_mode"] = snapshot["health"].get("sandbox", snapshot["sandbox_mode"])
            snapshot["pids_enforcement"] = snapshot["health"].get("pids_enforcement", snapshot["pids_enforcement"])
    except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError) as exc:
        snapshot["error"] = f"Daemon offline at {base} ({exc})"
    return snapshot


def render_frame(snap: dict) -> str:
    lines = []
    status_tag = "ONLINE" if snap["online"] else "OFFLINE (on-demand)"
    lines.append("=" * 76)
    lines.append(f"  AGENT CAPSULE JAIL v{snap['version']}  |  {snap['endpoint']}  |  {status_tag}")
    lines.append(f"  Sandbox: {snap['sandbox_mode']}  |  PIDs: {snap['pids_enforcement']}")
    lines.append("=" * 76)
    if snap["online"] and isinstance(snap["stats"], dict):
        st = snap["stats"]
        lines.append(
            f"  Total Capsules : {st.get('total_capsules', 0):<6} "
            f"Success : {st.get('successful', 0):<6} "
            f"Timeouts : {st.get('timeouts', 0):<5} "
            f"OOM Kills : {st.get('oom_kills', 0)}"
        )
        lines.append(
            f"  Total CPU (ms) : {st.get('total_cpu_ms', 0):<10} "
            f"Flight Recorder Dispatched : {st.get('flight_recorder_events', 0)}"
        )
        lines.append("-" * 76)
        lines.append("  RECENT CAPSULES:")
        caps = snap.get("recent_capsules") or []
        if not caps:
            lines.append("    (no capsules executed in this daemon session yet)")
        for cap in caps[:6]:
            cid = str(cap.get("capsule_id", ""))[:22]
            stt = str(cap.get("status", "?")).upper()[:10]
            dur = cap.get("duration_ms", 0)
            rss = cap.get("max_rss_kb", 0)
            rcpt = str(cap.get("receipt_sha256", ""))[:12]
            cmd = str(cap.get("command", "")).replace("\n", " ")[:32]
            lines.append(f"    {cid:<22} {stt:<10} {dur:>7.1f}ms {rss:>7}KB  {rcpt}  {cmd}")
    else:
        lines.append(f"  {snap.get('error') or 'Local daemon not running.'}")
        lines.append("  Start with: agent-capsule-jail serve --host 127.0.0.1 --port 8105")
    lines.append("=" * 76)
    lines.append("  Engineered by Neal Frazier Tech (@1nc0gn30) • NullAI Platform")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="agent-capsule-jail-tui",
        description="Agent Capsule Jail live loopback status & telemetry TUI (v2.6.0)",
    )
    parser.add_argument("--host", default="127.0.0.1", help="Daemon host (default: 127.0.0.1)")
    parser.add_argument("--port", type=int, default=8105, help="Daemon port (default: 8105)")
    parser.add_argument("--json", action="store_true", help="Print live JSON telemetry snapshot and exit")
    parser.add_argument("--once", action="store_true", help="Render one frame and exit")
    parser.add_argument("--interval", type=float, default=2.0, help="Refresh interval in seconds (watch mode)")
    args = parser.parse_args()

    if args.json:
        print(json.dumps(collect_snapshot(args.host, args.port), indent=2))
        return 0

    if args.once or not sys.stdout.isatty():
        print(render_frame(collect_snapshot(args.host, args.port)))
        return 0

    try:
        while True:
            snap = collect_snapshot(args.host, args.port)
            sys.stdout.write("\033[2J\033[H" + render_frame(snap) + "\n\n  Press Ctrl+C to exit.\n")
            sys.stdout.flush()
            time.sleep(max(0.5, args.interval))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
